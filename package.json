{
  "name": "vanilla-press",
  "version": "0.1.0",
  "description": "A platform-first content system built on web standards",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "seed": "node scripts/seed.js",
    "setup": "npm run seed",
    "dev": "node src/server/index.js",
    "serve": "node src/server/index.js"
  },
  "keywords": [
    "cms",
    "web-components",
    "static-site",
    "content-management",
    "hypermedia"
  ],
  "bin": {
    "vp": "./bin/vp.js"
  },
  "license": "MIT",
  "dependencies": {
    "@profpowell/bg-wc": "^0.4.0",
    "@profpowell/blink-wc": "^1.5.0",
    "@profpowell/border-wc": "^0.2.0",
    "@profpowell/browser-window": "^1.4.7",
    "@profpowell/code-block": "^2.9.0",
    "@profpowell/code-playground": "^0.2.0",
    "@profpowell/image-editor": "^0.1.0",
    "@profpowell/marquee-wc": "^1.7.0",
    "@profpowell/pdf-viewer": "^0.2.0",
    "@profpowell/terminal-window": "^2.1.0",
    "better-sqlite3": "^11.8.1",
    "vanilla-breeze": "file:../vanilla-breeze"
  },
  "devDependencies": {
    "cook-ssg": "^2.4.0",
    "gray-matter": "^4.0.3"
  }
}
