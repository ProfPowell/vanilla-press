              "children": [
                { "type": "list_item", "children": [{ "type": "paragraph", "children": [
                  { "type": "text", "value": "Engine:", "marks": ["strong"] },
                  { "type": "text", "value": " ProseMirror with custom NodeViews" }
                ] }] },
                { "type": "list_item", "children": [{ "type": "paragraph", "children": [
                  { "type": "text", "value": "Styling:", "marks": ["strong"] },
                  { "type": "text", "value": " Vanilla Breeze components render live in the editor" }
                ] }] },
                { "type": "list_item", "children": [{ "type": "paragraph", "children": [
                  { "type": "text", "value": "Themes:", "marks": ["strong"] },
                  { "type": "text", "value": " ~50 themes from Vanilla Breeze, applied via " },
                  { "type": "text", "value": "data-theme", "marks": ["code"] },
                  { "type": "text", "value": " on the html element" }
                ] }] }
              ]
            }
          ]
        },
        {
          "type": "tab",
          "attrs": { "label": "Deployment" },
          "children": [
            {
              "type": "list",
              "attrs": { "ordered": false },
              "children": [
                { "type": "list_item", "children": [{ "type": "paragraph", "children": [
                  { "type": "text", "value": "Hosting:", "marks": ["strong"] },
                  { "type": "text", "value": " Cloudflare Pages (static) + Workers (content negotiation)" }
                ] }] },
                { "type": "list_item", "children": [{ "type": "paragraph", "children": [
                  { "type": "text", "value": "CDN:", "marks": ["strong"] },
                  { "type": "text", "value": " 300+ edge locations, automatic SSL" }
                ] }] },
                { "type": "list_item", "children": [{ "type": "paragraph", "children": [
                  { "type": "text", "value": "Performance:", "marks": ["strong"] },
                  { "type": "text", "value": " ~25KB total page weight, 100/100 Lighthouse" }
                ] }] }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": { "level": 2 },
      "children": [
        { "type": "text", "value": "Why Not WordPress?" }
      ]
    },
    {
      "type": "paragraph",
      "children": [
        { "type": "text", "value": "WordPress is a PHP application that generates HTML on every request. Vanilla Press is a static publisher that pre-generates every output format at build time. The differences are fundamental:" }
      ]
    },
    {
      "type": "list",
      "attrs": { "ordered": false },
      "children": [
        {
          "type": "list_item",
          "children": [{ "type": "paragraph", "children": [
            { "type": "text", "value": "No server runtime", "marks": ["strong"] },
            { "type": "text", "value": " — static files, not PHP processes" }
          ] }]
        },
        {
          "type": "list_item",
          "children": [{ "type": "paragraph", "children": [
            { "type": "text", "value": "No plugin ecosystem", "marks": ["strong"] },
            { "type": "text", "value": " — and that's a feature. No attack surface, no update treadmill" }
          ] }]
        },
        {
          "type": "list_item",
          "children": [{ "type": "paragraph", "children": [
            { "type": "text", "value": "Content is portable", "marks": ["strong"] },
            { "type": "text", "value": " — JSON block ASTs, not a MySQL database with proprietary shortcodes" }
          ] }]
        },
        {
          "type": "list_item",
          "children": [{ "type": "paragraph", "children": [
            { "type": "text", "value": "Multi-format output", "marks": ["strong"] },
            { "type": "text", "value": " — WordPress serves HTML. VP serves HTML, markdown, JSON, Atom, and HTML fragments from the same content." }
          ] }]
        }
      ]
    },
    {
      "type": "blockquote",
      "children": [
        {
          "type": "paragraph",
          "children": [
            { "type": "text", "value": "The best CMS is the one that gets out of the way. Vanilla Press stores your content as structured data and renders it with pure functions. Everything else is the web platform." }
          ]
        }
      ]
    }
  ]
}
