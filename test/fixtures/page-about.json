{
  "id": "doc_about01",
  "meta": {
    "title": "About Vanilla Press",
    "slug": "about",
    "collection": "pages",
    "description": "Vanilla Press is a platform-first content system built on web standards. No frameworks, no build tools, no compromises.",
    "status": "published",
    "created": "2026-01-01",
    "updated": "2026-02-14",
    "published": "2026-02-14",
    "tags": []
  },
  "blocks": [
    {
      "type": "paragraph",
      "children": [
        { "type": "text", "value": "Vanilla Press is a content system where the component model, the editor, the storage, and the output are all built on web standards. A " },
        { "type": "text", "value": "callout", "marks": ["code"] },
        { "type": "text", "value": " block in the content store renders as a " },
        { "type": "text", "value": "<status-message>", "marks": ["code"] },
        { "type": "text", "value": " in HTML, a " },
        { "type": "text", "value": "> **Warning:**", "marks": ["code"] },
        { "type": "text", "value": " line in Markdown, and a typed JSON node over the API. One concept, multiple serializations, no lossy conversion." }
      ]
    },
    {
      "type": "heading",
      "attrs": { "level": 2 },
      "children": [
        { "type": "text", "value": "Principles" }
      ]
    },
    {
      "type": "list",
      "attrs": { "ordered": false },
      "children": [
        {
          "type": "list_item",
          "children": [{ "type": "paragraph", "children": [
            { "type": "text", "value": "Platform first", "marks": ["strong"] },
            { "type": "text", "value": " — CSS custom properties, custom elements, ES modules, SQLite. The web platform is the framework." }
          ] }]
        },
        {
          "type": "list_item",
          "children": [{ "type": "paragraph", "children": [
            { "type": "text", "value": "No build step", "marks": ["strong"] },
            { "type": "text", "value": " — no Webpack, no Vite, no TypeScript compiler. JavaScript runs as-is." }
          ] }]
        },
        {
          "type": "list_item",
          "children": [{ "type": "paragraph", "children": [
            { "type": "text", "value": "Content as data", "marks": ["strong"] },
            { "type": "text", "value": " — documents are structured block ASTs, not HTML strings or markdown files. The schema is the contract." }
          ] }]
        },
        {
          "type": "list_item",
          "children": [{ "type": "paragraph", "children": [
            { "type": "text", "value": "Multiple outputs", "marks": ["strong"] },
            { "type": "text", "value": " — same content renders to HTML (browsers), markdown (LLMs), JSON (APIs), and HTML fragments (hypermedia)." }
          ] }]
        },
        {
          "type": "list_item",
          "children": [{ "type": "paragraph", "children": [
            { "type": "text", "value": "Progressive enhancement", "marks": ["strong"] },
            { "type": "text", "value": " — everything works without JavaScript. JS adds interactivity, not structure." }
          ] }]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": { "level": 2 },
      "children": [
        { "type": "text", "value": "Tech Stack" }
      ]
    },
    {
      "type": "tabs",
      "children": [
