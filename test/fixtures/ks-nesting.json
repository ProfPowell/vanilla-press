          "children": [
            {
              "type": "callout",
              "attrs": { "variant": "danger" },
              "children": [
                {
                  "type": "paragraph",
                  "children": [
                    { "type": "text", "value": "Never expose the database file path to client-side code. The example below shows a server-only pattern:" }
                  ]
                },
                {
                  "type": "code_block",
                  "attrs": { "language": "js", "filename": "src/store/content.js" },
                  "value": "import Database from 'better-sqlite3';\n\n// Server-only — this path never reaches the client\nconst DB_PATH = process.env.DB_PATH || './data/content.db';\nconst db = new Database(DB_PATH);\n\nexport function getDocument(id) {\n  const row = db.prepare('SELECT * FROM documents WHERE id = ?').get(id);\n  if (!row) return null;\n  return {\n    id: row.id,\n    meta: JSON.parse(row.meta),\n    blocks: JSON.parse(row.blocks)\n  };\n}"
                }
              ]
            }
          ]
        },
        {
          "type": "tab",
          "attrs": { "label": "Client" },
          "children": [
            {
              "type": "callout",
              "attrs": { "variant": "tip" },
              "children": [
                {
                  "type": "paragraph",
                  "children": [
                    { "type": "text", "value": "On the client side, always use the API endpoint. The response format is the same:" }
                  ]
                },
                {
                  "type": "code_block",
                  "attrs": { "language": "js", "filename": "editor/assets/js/api-client.js" },
                  "value": "export async function getDocument(id) {\n  const res = await fetch(`/api/documents/${id}`);\n  if (!res.ok) throw new Error(`Failed to load document: ${res.status}`);\n  return res.json();\n}"
                }
              ]
            }
          ]
        },
        {
          "type": "tab",
          "attrs": { "label": "Worker" },
          "children": [
            {
              "type": "callout",
              "attrs": { "variant": "note" },
              "children": [
                {
                  "type": "paragraph",
                  "children": [
                    { "type": "text", "value": "In the Cloudflare Worker, the D1 binding replaces the local SQLite connection:" }
                  ]
                },
                {
                  "type": "code_block",
                  "attrs": { "language": "js", "filename": "src/worker/index.js" },
                  "value": "export default {\n  async fetch(request, env) {\n    const url = new URL(request.url);\n    const id = url.pathname.split('/').pop();\n\n    const { results } = await env.DB.prepare(\n      'SELECT * FROM documents WHERE id = ?'\n    ).bind(id).all();\n\n    if (!results.length) {\n      return new Response('Not found', { status: 404 });\n    }\n\n    return Response.json(results[0]);\n  }\n};"
                }
              ]
            }
          ]
        }
      ]
