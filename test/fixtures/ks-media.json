    {
      "type": "paragraph",
      "children": [
        { "type": "text", "value": "When a figure floats to the start (left in LTR layouts), surrounding text wraps around it. This is useful for small illustrations, icons, or author photos that complement the adjacent prose without interrupting the reading flow. The float clears automatically after the content moves past the image height." }
      ]
    },
    {
      "type": "heading",
      "attrs": { "level": 3 },
      "children": [
        { "type": "text", "value": "Float-End Figure" }
