{
  "$description": "Vanilla Press brand tokens (Bloom Seal 04), DTCG format. Mirrors tokens.css.",
  "brand": {
    "color": {
      "ink": { "$type": "color", "$value": "#23314F", "$description": "Primary seal wax; ink text on paper" },
      "ink-rim": { "$type": "color", "$value": "#141C30" },
      "vanilla": { "$type": "color", "$value": "#ECD89A", "$description": "Reversed seal wax, used on ink" },
      "vanilla-rim": { "$type": "color", "$value": "#C9AD62" },
      "petal": { "$type": "color", "$value": "#F7EEDB", "$description": "Petals on the ink seal; text on ink" },
      "eye": { "$type": "color", "$value": "#F0C95A" },
      "eye-dark": { "$type": "color", "$value": "#B07A4A" },
      "paper": { "$type": "color", "$value": "#FFFAF0" },
      "parchment": { "$type": "color", "$value": "#F4EDE0" },
      "icon-tile": { "$type": "color", "$value": "#F3E7B8" },
      "pod": { "$type": "color", "$value": "#5A3A24" }
    },
    "font": {
      "display": { "$type": "fontFamily", "$value": ["Fraunces", "Charter", "Bitstream Charter", "Georgia", "serif"] }
    },
    "mark": {
      "bumps": { "$type": "number", "$value": 16 },
      "bump-depth": { "$type": "number", "$value": 1 },
      "valley-radius": { "$type": "number", "$value": 66, "$description": "In the 200-unit drawing space, centre at 100,100" },
      "rim-radius": { "$type": "number", "$value": 55 },
      "petal-width": { "$type": "number", "$value": 11 },
      "petal-length": { "$type": "number", "$value": 22 },
      "petal-reach": { "$type": "number", "$value": 26 },
      "eye-radius": { "$type": "number", "$value": 9 }
    }
  }
}
