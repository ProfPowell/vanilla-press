    {
      "type": "figure",
      "attrs": {
        "src": "/media/lighthouse-score.png",
        "alt": "Lighthouse performance audit showing a score of 100 for Performance, Accessibility, Best Practices, and SEO",
        "variant": "float-end"
      },
      "children": [
        {
          "type": "figcaption",
          "children": [
            { "type": "text", "value": "A perfect Lighthouse score." }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "children": [
        { "type": "text", "value": "Float-end places the figure on the opposite side. In left-to-right layouts, the image appears on the right with text flowing to its left. This variant works well for supplementary data visualizations, badges, or small charts that support the main content without demanding primary attention." }
      ]
    },
