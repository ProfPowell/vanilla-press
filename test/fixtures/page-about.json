              "children": [
                { "type": "list_item", "children": [{ "type": "paragraph", "children": [
                  { "type": "text", "value": "HTML:", "marks": ["strong"] },
                  { "type": "text", "value": " Semantic markup with Vanilla Breeze custom elements" }
                ] }] },
                { "type": "list_item", "children": [{ "type": "paragraph", "children": [
                  { "type": "text", "value": "Markdown:", "marks": ["strong"] },
                  { "type": "text", "value": " Clean output with YAML frontmatter" }
                ] }] },
                { "type": "list_item", "children": [{ "type": "paragraph", "children": [
                  { "type": "text", "value": "Feeds:", "marks": ["strong"] },
                  { "type": "text", "value": " Atom XML, sitemap.xml, llms.txt" }
                ] }] }
              ]
            }
          ]
        },
        {
