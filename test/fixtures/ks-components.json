    "title": "Kitchen Sink: Components",
    "slug": "ks-components",
    "collection": "kitchen-sink",
    "description": "Exercises all component block types: callouts, collapsibles, cards, tabs, steps, and nested combinations.",
    "author_id": "author_t1",
    "status": "published",
    "created": "2026-02-17",
    "updated": "2026-02-17",
