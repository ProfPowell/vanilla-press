              "children": [
                { "type": "list_item", "children": [{ "type": "paragraph", "children": [
                  { "type": "text", "value": "Storage:", "marks": ["strong"] },
                  { "type": "text", "value": " SQLite (local) / Cloudflare D1 (production)" }
                ] }] },
                { "type": "list_item", "children": [{ "type": "paragraph", "children": [
                  { "type": "text", "value": "Schema:", "marks": ["strong"] },
                  { "type": "text", "value": " Typed block AST defined in content-schema.js" }
                ] }] },
                { "type": "list_item", "children": [{ "type": "paragraph", "children": [
                  { "type": "text", "value": "Search:", "marks": ["strong"] },
                  { "type": "text", "value": " FTS5 full-text search on title, description, and plaintext" }
                ] }] }
              ]
            }
          ]
        },
        {
          "type": "tab",
          "attrs": { "label": "Rendering" },
          "children": [
            {
              "type": "list",
